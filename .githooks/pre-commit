#!/usr/bin/env bash
# pre-commit hook — Checks that Go source files are formatted with gofmt
# and that go.mod / go.sum are tidy.
#
# Install with:
#   git config core.hooksPath .githooks
#
# Bypass with:
#   git commit --no-verify

set -euo pipefail

# ---------- Check 1: gofmt ----------

# Only check staged .go files to keep the hook fast.
# Uses a while-read loop instead of mapfile for Bash 3.2 compatibility (macOS).
STAGED_GO_FILES=()
while IFS= read -r file; do
  STAGED_GO_FILES+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACM -- '*.go')

if [ ${#STAGED_GO_FILES[@]} -eq 0 ]; then
  # No Go files staged — skip both checks
  exit 0
fi

UNFORMATTED=()
for file in "${STAGED_GO_FILES[@]}"; do
  if [ -n "$(gofmt -l "$file" 2>/dev/null)" ]; then
    UNFORMATTED+=("$file")
  fi
done

if [ ${#UNFORMATTED[@]} -gt 0 ]; then
  echo "❌ The following files need formatting (run 'gofmt -w .' or 'make fmt'):"
  echo ""
  for file in "${UNFORMATTED[@]}"; do
    echo "  $file"
  done
  echo ""
  exit 1
fi

# ---------- Check 2: go mod tidy ----------

# Only run when go.mod, go.sum, or .go files are staged.
STAGED_MOD_FILES=()
while IFS= read -r file; do
  STAGED_MOD_FILES+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACM -- 'go.mod' 'go.sum')

if [ ${#STAGED_MOD_FILES[@]} -gt 0 ] || [ ${#STAGED_GO_FILES[@]} -gt 0 ]; then
  # Take a snapshot of go.mod and go.sum before tidy
  MOD_BEFORE=$(cat go.mod)
  SUM_BEFORE=""
  if [ -f go.sum ]; then
    SUM_BEFORE=$(cat go.sum)
  fi

  go mod tidy 2>/dev/null

  MOD_AFTER=$(cat go.mod)
  SUM_AFTER=""
  if [ -f go.sum ]; then
    SUM_AFTER=$(cat go.sum)
  fi

  # Restore original files — the hook should only check, not modify
  echo "$MOD_BEFORE" > go.mod
  if [ -n "$SUM_BEFORE" ]; then
    echo "$SUM_BEFORE" > go.sum
  fi

  if [ "$MOD_BEFORE" != "$MOD_AFTER" ] || [ "$SUM_BEFORE" != "$SUM_AFTER" ]; then
    echo "❌ go.mod or go.sum are not tidy (run 'go mod tidy')."
    echo ""
    exit 1
  fi
fi
